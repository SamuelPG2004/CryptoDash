# ==============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO PARA PRODUCCIÓN (Vercel & MongoDB Atlas)
# ==============================================================================
# Copia las siguientes llaves e inyecta tus valores reales directamente en 
# el panel de configuración de entorno de Vercel (Project Settings -> Environment Variables).
# NUNCA subas valores reales ni secretos a repositorios de Git.
# ==============================================================================

# Entorno de ejecución de Node.js (Vercel lo establece automáticamente en 'production')
NODE_ENV="production"

# URL base de tu aplicación desplegada en Vercel (ej: https://cryptodash.vercel.app)
# Se utiliza para configurar las políticas CORS y redirecciones seguras.
APP_URL=""

# String de conexión oficial para MongoDB Atlas.
# Formato: mongodb+srv://<usuario>:<password>@cluster0.mongodb.net/cryptodash?retryWrites=true&w=majority
MONGODB_URI=""

# Clave secreta criptográfica de alta entropía para firmar los JSON Web Tokens (JWT).
# REQUERIDO: El backend se negará a iniciar en producción si esta variable está vacía.
# Puedes generar una segura ejecutando en terminal: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=""

# ------------------------------------------------------------------------------
# ADAPTERS DE INTELIGENCIA ARTIFICIAL (AI PROVIDERS)
# ------------------------------------------------------------------------------
# Define qué proveedor de IA usará la aplicación por defecto ('groq' | 'openai' | 'mock')
AI_PROVIDER="groq"

# API Key para Groq (LLaMA 3) - Principal proveedor ultra-rápido de análisis de mercado
# Consíguela en: https://console.groq.com/keys
GROQ_API_KEY=""

# API Key para OpenAI (Opcional, en caso de cambiar AI_PROVIDER a 'openai')
OPENAI_API_KEY=""

# API Key para Google Gemini (Opcional, para análisis alternativos con modelos Gemini)
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# CACHE DISTRIBUIDA
# ------------------------------------------------------------------------------
# (Opcional) Conexión a Redis para mantener precios sincronizados entre servidores.
# Si el servidor se cae o no se provee, el sistema usará caché local tolerante a fallos.
REDIS_URL=""
