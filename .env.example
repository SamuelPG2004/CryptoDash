# MONGODB_URI: Connection string para MongoDB Atlas
# Formato: mongodb+srv://<usuario>:<password>@cluster0.mongodb.net/cryptodash
MONGODB_URI="mongodb+srv://<user>:<pass>@cluster0.example.mongodb.net/cryptodash"

# JWT_SECRET: Clave secreta para firmar JSON Web Tokens
# Debe ser una cadena larga y aleatoria. Nunca compartas esto públicamente.
# Genera una con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ⚠️  REQUERIDO en producción — la app falla al iniciar si no está configurado.
JWT_SECRET="your_super_secret_jwt_key_here"

# GROQ_API_KEY: API key de Groq para análisis de mercado con IA (LLaMA 3)
# Se lee ÚNICAMENTE en el backend (geminiService.ts). NUNCA se expone al frontend.
# Obtén una en: https://console.groq.com/keys
GROQ_API_KEY="your_groq_api_key_here"

# APP_URL: URL donde se aloja la aplicación
# En desarrollo: http://localhost:3000
# En Vercel: tu dominio asignado (ej: https://cryptodash.vercel.app)
APP_URL="http://localhost:3000"

# NODE_ENV: Entorno de ejecución (development | production)
# Vercel lo configura automáticamente. Solo necesitas esto en deploys manuales.
NODE_ENV="development"

# REDIS_URL: (Opcional) URL de conexión a la caché distribuida de Redis
# Si no se provee, la aplicación usará la memoria RAM local (L1 Cache Fallback)
# REDIS_URL="redis://default:password@localhost:6379"
